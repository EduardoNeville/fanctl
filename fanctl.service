[Unit]
Description=fanctl — ESP32 PWM/tach fan curve (Tesla P40 cooling)
Documentation=file:/home/eduardoneville/pkgs/fanctl/README.md
After=dev-ttyACM0.device
BindsTo=dev-ttyACM0.device
StartLimitIntervalSec=0

[Service]
Type=simple
# root: /dev/ttyACM0 is root:dialout and root needs no group gymnastics.
# (Alternatively: usermod -aG dialout eduardoneville + User=eduardoneville)
User=root
ExecStart=/home/eduardoneville/pkgs/fanctl/fanctl.py --port /dev/ttyACM0 --gpu --floor 25 --interval 2
# If the host dies or the port breaks, systemd restarts us; if we are dead for
# 5 s, the ESP32 firmware fails safe to 100% duty. Loud, never quiet.
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
